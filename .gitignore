# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Packaging and build output
build/
dist/
target/
*.egg-info/

# Environment variables and local configuration
.env
.env.*
!.env.example

# IDEs and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
*.tmp
*.swp
target/

# Local data and model artifacts (keep directory placeholders)
data/*
!data/.gitkeep
models/*
!models/.gitkeep
