# Copy this file to .env and replace all example credentials.
MYSQL_DATABASE=fashion_search
MYSQL_USERNAME=fashion_search
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-password

# Optional public API host port overrides. MySQL and Redis stay private to the
# Compose network.
FASTAPI_PORT_HOST=8000
SPRING_BOOT_PORT_HOST=8080

# Read-only host mounts. Forward slashes are recommended in Windows .env files.
FASHION_SEARCH_DATA_HOST_PATH=./data
FASHION_SEARCH_MODEL_CACHE_HOST_PATH=C:/Users/your-name/.cache/huggingface
FASHION_SEARCH_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Keep false when the model already exists in the mounted Hugging Face cache.
FASHION_SEARCH_ALLOW_MODEL_DOWNLOAD=false
